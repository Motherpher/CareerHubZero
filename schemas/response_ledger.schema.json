{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerHub Market Response Ledger",
  "type": "object",
  "required": ["schema_version", "events", "stage_vocabulary"],
  "properties": {
    "schema_version": {"type": "string"},
    "stage_vocabulary": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "events": {"type": "array", "items": {
      "type": "object",
      "required": ["event_id", "occurred_at", "stage"],
      "properties": {
        "event_id": {"type": "string"},
        "occurred_at": {"type": "string"},
        "stage": {"type": "string"},
        "job_id": {"type": ["string", "null"]},
        "application_id": {"type": ["string", "null"]},
        "lane_id": {"type": ["string", "null"]},
        "surface_id": {"type": ["string", "null"]},
        "direction": {"type": ["string", "null"], "enum": ["inbound", "outbound", null]},
        "source": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }}
  },
  "additionalProperties": false
}
