{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerHub Response Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at", "stage", "surface_id"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "opportunity_id": {"type": ["string", "null"]},
    "application_id": {"type": ["string", "null"]},
    "surface_id": {"type": "string", "minLength": 1},
    "sector": {"type": ["string", "null"]},
    "stage": {
      "type": "string",
      "enum": [
        "exposed", "viewed", "saved", "shortlisted", "recruiter_contact",
        "qualified_contact", "application", "interview_1", "interview_2_plus",
        "case_test", "reference_check", "offer", "assignment", "denied",
        "withdrawn", "no_response"
      ]
    },
    "source": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}