{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerHub Candidate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "positioning", "evidence", "verification_queue"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "positioning": {
      "type": "object",
      "required": ["default_surface", "surfaces"],
      "properties": {
        "default_surface": {"type": "string", "minLength": 1},
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "status": {"type": "string", "enum": ["active", "specialist", "paused"]},
              "headline": {"type": "string"},
              "search_lanes": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "status", "provenance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["verified", "project_claim", "positioning_hypothesis"]
          },
          "provenance": {"type": "array", "items": {"type": "string"}},
          "external_use": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "verification_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["open", "resolved", "retired"]},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "career_preferences": {"type": "object", "additionalProperties": true}
  }
}