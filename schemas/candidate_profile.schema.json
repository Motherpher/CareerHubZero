{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerHub Candidate Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "career_sources",
    "evidence",
    "verification_queue"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "career_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_type",
          "reference",
          "verification_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "cv",
              "professional_profile",
              "employment_record",
              "qualification",
              "certification",
              "portfolio_work_sample",
              "employer_reference",
              "verified_project_record"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "const": "verified"
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "status",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "verified"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "external_use": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string"
        },
        "functional_core": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived_from_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "retired"
            ]
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    }
  }
}
