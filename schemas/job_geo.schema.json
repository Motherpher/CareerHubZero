{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerHub Job Geography Tag",
  "type": "object",
  "required": [
    "status",
    "provider",
    "point",
    "precision",
    "confidence",
    "scope",
    "hierarchy",
    "country_matrix",
    "tagged_at"
  ],
  "properties": {
    "status": {
      "enum": ["tagged", "unresolved", "remote", "unknown"]
    },
    "provider": {
      "type": ["string", "null"]
    },
    "place_id": {
      "type": ["string", "null"]
    },
    "source_query": {
      "type": ["string", "null"]
    },
    "location_basis": {
      "type": ["string", "null"]
    },
    "formatted_address": {
      "type": ["string", "null"]
    },
    "display_name": {
      "type": ["string", "null"]
    },
    "point": {
      "anyOf": [
        {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": {"type": "number", "minimum": -90, "maximum": 90},
            "lng": {"type": "number", "minimum": -180, "maximum": 180}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "precision": {
      "enum": [
        "source_coordinates",
        "premise",
        "street",
        "postal_code",
        "district",
        "locality",
        "admin2",
        "admin1",
        "country",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scope": {
      "enum": ["point", "area", "remote", "unknown"]
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": true
    },
    "country_matrix": {
      "type": "object",
      "additionalProperties": true
    },
    "work_setting": {
      "type": ["string", "null"]
    },
    "tagged_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
