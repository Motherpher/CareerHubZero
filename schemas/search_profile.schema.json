{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerHub Search Profile 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "intent",
    "geographies",
    "lanes",
    "negative_filters",
    "triage_rule",
    "user_search_overlay"
  ],
  "properties": {
    "version": {
      "const": "2.1"
    },
    "intent": {
      "type": "string"
    },
    "geographies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country",
        "anchors",
        "remote_allowed",
        "remote_scopes",
        "progressive_widening"
      ],
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote_allowed": {
          "type": "boolean"
        },
        "remote_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progressive_widening": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "travel_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "mode",
            "max_minutes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": [
                "DRIVE",
                "TRANSIT",
                "WALK",
                "BICYCLE",
                "TWO_WHEELER"
              ]
            },
            "max_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 360
            }
          }
        }
      }
    },
    "engagement_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "salary": {
      "type": "object",
      "additionalProperties": true
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "name",
          "bucket",
          "priority",
          "queries"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bucket": {
            "type": "string",
            "enum": [
              "core",
              "adjacent",
              "bridge"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "negative_filters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triage_rule": {
      "type": "string"
    },
    "user_search_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "scope",
        "specific_wishes_or_needs"
      ],
      "properties": {
        "source": {
          "const": "user_input"
        },
        "scope": {
          "const": "search_only"
        },
        "specific_wishes_or_needs": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
